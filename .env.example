# Claude API 키 (고지서 판독에 필요). Vercel > Settings > Environment Variables 에 등록하세요.
ANTHROPIC_API_KEY=
# (선택) 설정하면 판독 기능 사용 시 이 접속코드를 입력해야 합니다. 외부인이 API 비용을 쓰는 것을 막습니다.
ACCESS_CODE=
# 서버 저장소 (Vercel > Storage 에서 Upstash for Redis 를 연결하면 자동으로 들어갑니다)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (선택) 입력이 없을 때 자동으로 잠그는 시간(분). 기본 30분
NEXT_PUBLIC_IDLE_MINUTES=30
